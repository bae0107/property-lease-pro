<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- =========================================================
         019: door_credential 门锁密码凭证（入住/换宿生成，退宿/换宿作废）
         约定沿用 015 occupancy 表：snake_case 列名、无 IsDeleted（状态字段表达生命周期）
         ========================================================= -->
    <changeSet id="019-door-credential" author="dev">
        <createTable tableName="door_credential" remarks="门锁密码凭证（与 stay 绑定，密码 AES-GCM 加密存储）">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="stay_id" type="BIGINT" remarks="stay.id">
                <constraints nullable="false"/>
            </column>
            <column name="room_id" type="BIGINT" remarks="room_info.RoomId">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="BIGINT" remarks="customer.employee.id">
                <constraints nullable="false"/>
            </column>
            <column name="iam_user_id" type="BIGINT" remarks="stay.iam_user_id 冗余，租客查询免 join">
                <constraints nullable="false"/>
            </column>
            <column name="password_enc" type="VARCHAR(256)" remarks="AES-256-GCM 加密（Base64: iv‖cipher‖tag）">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(16)" remarks="ACTIVE|REVOKED，同一 stay 最多一条 ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME(3)"><constraints nullable="false"/></column>
            <column name="revoked_at" type="DATETIME(3)"/>
        </createTable>

        <createIndex tableName="door_credential" indexName="idx_door_credential_stay">
            <column name="stay_id"/>
        </createIndex>
        <createIndex tableName="door_credential" indexName="idx_door_credential_iam_user">
            <column name="iam_user_id"/>
            <column name="status"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
